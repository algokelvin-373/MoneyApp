<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp"
    android:layout_height="140dp"
    android:layout_marginEnd="16dp"
    android:background="@drawable/bg_home_wallet_light"
    android:elevation="3dp"
    android:orientation="vertical"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/image_wallet_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_home_icon_blue"
            android:contentDescription="@null"
            android:padding="9dp"
            android:src="@drawable/ic_home_cash" />

        <TextView
            android:id="@+id/text_wallet_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/home_muted"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_wallet_balance"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:textColor="@color/home_text"
        android:textSize="31sp"
        android:textStyle="bold" />
</LinearLayout>
