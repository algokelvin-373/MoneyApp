<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="18dp"
    android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center_vertical" android:orientation="horizontal">
        <View android:layout_width="6dp" android:layout_height="18dp" android:background="@drawable/bg_history_day_marker" />
        <TextView android:id="@+id/text_group_date" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:textColor="@color/home_text" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/text_group_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/home_muted" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/transactions_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_history_summary"
        android:elevation="1dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp" />
</LinearLayout>
